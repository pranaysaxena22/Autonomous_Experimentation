{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executed timeline (format version 1)",
  "description": "What the executor returns for one trial: every planned action with its actual times and outcome, plus any recovery actions it added. Each action is tagged origin 'planned' or 'recovery'. The 3D viewer replays this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "label", "data_status", "executed_id", "plan_id", "plan_file", "trial", "trial_start_minute", "layout_id", "executor", "outcome", "faults", "step_totals_s", "result", "time_note", "actions"],
  "properties": {
    "format_version": {"const": 1},
    "label": {"type": "string", "minLength": 1},
    "data_status": {"enum": ["synthetic", "illustrative", "real", "validated"]},
    "executed_id": {"type": "string", "pattern": "^T[0-9]{3,}-executed$"},
    "plan_id": {"type": "string", "pattern": "^T[0-9]{3,}$"},
    "plan_file": {"$ref": "#/$defs/relative_path"},
    "trial": {"type": "integer", "minimum": 1},
    "trial_start_minute": {"type": "number", "minimum": 0},
    "layout_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "executor": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "outcome": {"enum": ["completed", "completed_after_recovery", "skipped"]},
    "faults": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["action_id", "cause", "where", "recovered", "recovery_action_ids"],
                "properties": {"action_id": {"type": "string", "pattern": "^A[0-9]{3,}$"}, "cause": {"type": "string", "minLength": 1}, "where": {"$ref": "#/$defs/where"}, "recovered": {"type": "boolean"},
                               "recovery_action_ids": {"type": "array", "items": {"type": "string", "pattern": "^R[0-9]{3,}$"}}}}
    },
    "step_totals_s": {"type": "object", "additionalProperties": false, "required": ["planned", "actual"],
                      "properties": {"planned": {"$ref": "#/$defs/step_numbers"}, "actual": {"$ref": "#/$defs/step_numbers"}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["dissolution_30min_pct", "hardness_kp", "friability_pct", "verdict"],
               "properties": {"dissolution_30min_pct": {"type": ["number", "null"]}, "hardness_kp": {"type": ["number", "null"]}, "friability_pct": {"type": ["number", "null"]}, "verdict": {"enum": ["Good", "Not good", "No result"]}}},
    "time_note": {"type": "string"},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "id_ref": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "relative_path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))[^:*?\"<>|]+$"},
    "step_numbers": {"type": "object", "additionalProperties": false, "required": ["dispense", "mix", "press", "test", "clean"],
                     "properties": {"dispense": {"type": "number"}, "mix": {"type": "number"}, "press": {"type": "number"}, "test": {"type": "number"}, "clean": {"type": "number"}}},
    "where": {"type": "object", "additionalProperties": false, "required": ["step", "action"],
              "properties": {"step": {"enum": ["dispense", "mix", "press", "test", "clean"]}, "action": {"enum": ["move", "pick", "place", "pour", "shake", "press", "stir", "scan", "read", "wait"]}, "ingredient": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_pct$"}}},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origin", "step", "phase", "type", "actual_start_s", "actual_duration_s", "outcome", "caption"],
      "properties": {
        "id": {"type": "string", "pattern": "^[AR][0-9]{3,}$"},
        "origin": {"enum": ["planned", "recovery"]},
        "step": {"enum": ["dispense", "mix", "press", "test", "clean"]},
        "phase": {"enum": ["act", "sense", "reason", "adapt"]},
        "type": {"enum": ["move", "pick", "place", "pour", "shake", "press", "stir", "scan", "read", "wait"]},
        "object": {"$ref": "#/$defs/id_ref"}, "from": {"$ref": "#/$defs/id_ref"}, "to": {"$ref": "#/$defs/id_ref"}, "into": {"$ref": "#/$defs/id_ref"}, "at": {"$ref": "#/$defs/id_ref"},
        "amount_g": {"type": "number", "exclusiveMinimum": 0}, "style": {"enum": ["mix", "tap"]}, "force_kn": {"type": "number", "exclusiveMinimum": 0},
        "quantity": {"type": "string", "pattern": "^(barcode|[a-z][a-z0-9_]*_(g|pct|kp|kn|min|s))$"}, "reason": {"type": "string", "minLength": 1},
        "planned_start_s": {"type": "number", "minimum": 0}, "planned_duration_s": {"type": "number", "exclusiveMinimum": 0},
        "actual_start_s": {"type": "number", "minimum": 0}, "actual_duration_s": {"type": "number", "exclusiveMinimum": 0},
        "outcome": {"enum": ["ok", "failed", "interrupted"]},
        "recovers": {"type": "string", "pattern": "^A[0-9]{3,}$"},
        "reading": {"type": "object", "additionalProperties": false, "required": ["quantity", "value"],
                    "properties": {"quantity": {"type": "string", "pattern": "^(barcode|[a-z][a-z0-9_]*_(g|pct|kp|kn|min|s))$"}, "expected": {"type": ["number", "string"]}, "value": {"type": ["number", "string"]}}},
        "fault": {"type": "object", "additionalProperties": false, "required": ["cause", "where", "detail"],
                  "properties": {"cause": {"type": "string", "minLength": 1}, "where": {"$ref": "#/$defs/where"}, "detail": {"type": "string"}}},
        "caption": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"origin": {"const": "planned"}}, "required": ["origin"]}, "then": {"required": ["planned_start_s", "planned_duration_s"], "not": {"required": ["recovers"]}}},
        {"if": {"properties": {"origin": {"const": "recovery"}}, "required": ["origin"]}, "then": {"required": ["recovers"], "not": {"anyOf": [{"required": ["planned_start_s"]}, {"required": ["planned_duration_s"]}]}}},
        {"if": {"properties": {"outcome": {"enum": ["failed", "interrupted"]}}, "required": ["outcome"]}, "then": {"required": ["fault"]}},
        {"if": {"properties": {"type": {"const": "move"}}, "required": ["type"]}, "then": {"required": ["to"]}},
        {"if": {"properties": {"type": {"const": "pick"}}, "required": ["type"]}, "then": {"required": ["object", "from"]}},
        {"if": {"properties": {"type": {"const": "place"}}, "required": ["type"]}, "then": {"required": ["object", "to"]}},
        {"if": {"properties": {"type": {"const": "pour"}}, "required": ["type"]}, "then": {"required": ["object", "into", "at", "amount_g"]}},
        {"if": {"properties": {"type": {"const": "shake"}}, "required": ["type"]}, "then": {"required": ["object", "style"]}},
        {"if": {"properties": {"type": {"const": "press"}}, "required": ["type"]}, "then": {"required": ["object", "at", "force_kn"]}},
        {"if": {"properties": {"type": {"const": "stir"}}, "required": ["type"]}, "then": {"required": ["object", "at"]}},
        {"if": {"properties": {"type": {"const": "scan"}}, "required": ["type"]}, "then": {"required": ["object", "at"]}},
        {"if": {"properties": {"type": {"const": "read"}}, "required": ["type"]}, "then": {"required": ["at", "quantity"]}},
        {"if": {"properties": {"type": {"const": "wait"}}, "required": ["type"]}, "then": {"required": ["reason"]}}
      ]
    }
  }
}
